<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Test commands over adb, debug builds only. DUMP is held by the adb shell, not by regular apps,
            so no other app on the phone can send commands.
        -->
        <receiver
            android:name=".demo.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
