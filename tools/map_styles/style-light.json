{
  "version": 8,
  "name": "Ping Up light",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://file://__PACK__/costinesti.pmtiles",
      "minzoom": 0,
      "maxzoom": 15,
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">© OpenStreetMap contributors</a>"
    }
  },
  "glyphs": "file://__ASSETS__/fonts/{fontstack}/{range}.pbf",
  "sprite": "file://__ASSETS__/sprites/v4/light",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#80deea"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#e2dfda"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "maxzoom": 8,
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "forest",
          "#9cd3b4",
          "grassland",
          "#9cd3b4",
          "farmland",
          "#ece8d8",
          "barren",
          "#e2e0d7",
          "#e2dfda"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "national_park",
            "nature_reserve",
            "protected_area",
            "garden",
            "grass",
            "grassland",
            "forest",
            "wood",
            "scrub",
            "cemetery",
            "golf_course",
            "playground"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#9cd3b4"
      }
    },
    {
      "id": "landuse-beach",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "beach",
            "sand"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#f2e6b8"
      }
    },
    {
      "id": "landuse-urban",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "pedestrian",
            "hospital",
            "school",
            "university",
            "college",
            "industrial",
            "railway",
            "parking",
            "military"
          ]
        ]
      ],
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "pedestrian",
          "#e3e0d4",
          "hospital",
          "#e4dad9",
          [
            "school",
            "university",
            "college"
          ],
          "#e4ded7",
          "#d1dde1"
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#80deea"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#80deea",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          11,
          0.5,
          18,
          6
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#cccccc",
        "fill-outline-color": "#bdbab4",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          15,
          0.9
        ]
      }
    },
    {
      "id": "roads-other",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "other"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f5f3ef",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          14,
          0.3,
          18,
          2.5
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "roads-path",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "path"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f5f3ef",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          14,
          0.3,
          18,
          2.5
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "roads-minor_road-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "minor_road"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d4d2cd",
        "line-gap-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          12,
          0.3,
          18,
          8
        ],
        "line-width": 1
      }
    },
    {
      "id": "roads-minor_road",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "minor_road"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          12,
          0.3,
          18,
          8
        ]
      }
    },
    {
      "id": "roads-major_road-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "major_road"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d4d2cd",
        "line-gap-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          18,
          12
        ],
        "line-width": 1
      }
    },
    {
      "id": "roads-major_road",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "major_road"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          18,
          12
        ]
      }
    },
    {
      "id": "roads-highway-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "highway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d4d2cd",
        "line-gap-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          18,
          16
        ],
        "line-width": 1
      }
    },
    {
      "id": "roads-highway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 8,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "highway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.6
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          18,
          16
        ]
      }
    },
    {
      "id": "roads-rail",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#a7b1b3",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.6,
          18,
          2.5
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "roads-label",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "highway",
            "major_road",
            "minor_road",
            "path"
          ]
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ro"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12
      },
      "paint": {
        "text-color": "#616161",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "water",
      "minzoom": 10,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ro"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3d7a8a",
        "text-halo-color": "#80deea",
        "text-halo-width": 1
      }
    },
    {
      "id": "pois",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "pois",
      "minzoom": 15,
      "layout": {
        "icon-image": [
          "get",
          "kind"
        ],
        "icon-size": 0.9,
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ro"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-anchor": "top",
        "text-offset": [
          0,
          0.9
        ],
        "text-max-width": 8,
        "text-optional": true
      },
      "paint": {
        "text-color": "#5c5c5c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "locality",
            "neighbourhood",
            "macrohood",
            "region",
            "country"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:ro"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Medium"
        ],
        "text-size": [
          "match",
          [
            "get",
            "kind"
          ],
          "locality",
          15,
          "region",
          13,
          "country",
          13,
          12
        ],
        "text-transform": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "neighbourhood",
            "macrohood"
          ],
          "uppercase",
          "none"
        ],
        "text-letter-spacing": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "neighbourhood",
            "macrohood"
          ],
          0.1,
          0
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3d3d3d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
