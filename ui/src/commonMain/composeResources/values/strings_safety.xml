    <!-- Nu sunt bine -->
    <string name="unwell_title">Nu sunt bine</string>
    <string name="unwell_row_text">Anxietate, panică, prea multe deodată</string>
    <string name="unwell_text">Anxietate, panică, prea multe deodată: se întâmplă și nu ești singur. Spune ce simți, iar echipa de bunăstare poate veni la tine sau te poate primi la Safe Zone. Mesajul pleacă discret, cu poziția ta.</string>
    <string name="unwell_kind_anxiety">Anxietate</string>
    <string name="unwell_kind_panic">Atac de panică</string>
    <string name="unwell_kind_overwhelmed">Mă simt copleșit</string>
    <string name="unwell_kind_other">Altceva</string>
    <string name="unwell_message">Nu mă simt bine: %1$s.</string>
    <string name="unwell_send">Cheamă echipa de bunăstare</string>
    <string name="unwell_sent_title">Echipa a primit mesajul</string>
    <string name="unwell_sent_text">Rămâi unde ești, într-un loc cât mai liniștit, sau mergi la Safe Zone. Răspunsul vine discret, fără sunet.</string>
    <string name="unwell_withdraw">Retrage mesajul</string>
    <string name="unwell_off_text">Organizatorul n-a pus aici o echipă care să răspundă prin aplicație. Mergi la cel mai apropiat punct medical sau la Safe Zone și spune cum te simți.</string>
    <!-- DRAFT, waiting for the medical lead's approval (co-signed with Caravana cu Medici or ANPCDDA): the breathing guide below, until then not final -->
    <string name="unwell_breathe_title">Până vine cineva</string>
    <string name="unwell_inhale">Inspiră</string>
    <string name="unwell_exhale">Expiră</string>
    <string name="unwell_breathe_1">Așază-te undeva sigur, dacă poți, și sprijină-ți spatele.</string>
    <string name="unwell_breathe_2">Inspiră pe nas, încet, numărând până la 4.</string>
    <string name="unwell_breathe_3">Expiră pe gură, și mai încet, numărând până la 6.</string>
    <string name="unwell_breathe_4">Repetă de zece ori. Dacă ți se face amețeală, respiră normal câteva clipe.</string>
    <string name="unwell_breathe_5">Apoi privește în jur și numește în gând 5 lucruri pe care le vezi.</string>
    <string name="unwell_breathe_physical">Dacă ai dureri în piept, nu poți respira sau ți-e rău fizic, sună la 112.</string>

